# Local processes bind both listeners to host loopback by default. Docker
# Compose overrides these two addresses inside the container, then publishes
# both ports back to host loopback.
SERVER_ADDR=127.0.0.1:8080
ADMIN_SERVER_ADDR=127.0.0.1:8081

PUBLIC_BASE_URL=https://brain-slug.example.com

AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
# api_key uses the official OpenAI API. chatgpt uses the local dashboard's
# ChatGPT account connection and the account-scoped Codex transport.
OPENAI_AUTH_MODE=api_key
# Defaults beside SQLITE_PATH (for example ./brainslug.openai-auth.json).
# OPENAI_CHATGPT_AUTH_FILE=./brainslug.openai-auth.json
OPENAI_MODEL=gpt-5.6-terra
# Leave blank for the official endpoint. Custom endpoints belong in the
# independent OPENAI_COMPATIBLE_* route below.
OPENAI_BASE_URL=

# Reasoning models spend max_output_tokens on both internal reasoning and
# visible output. This is headroom, not a target answer length.
OPENAI_MAX_OUTPUT_TOKENS=25000

# The current ASK path is synchronous. Alexa abandons a response after 8
# seconds, so every *_TIMEOUT_SECONDS value must be between 1 and 6; each
# request also runs under a 7-second budget that covers verification and
# saving the outcome.
OPENAI_TIMEOUT_SECONDS=6

# Leave blank for the provider default. GPT-5.6 also supports none, low,
# medium, high, xhigh, and max.
OPENAI_REASONING_EFFORT=

# Leave blank for the provider default. Official OpenAI accepts low, medium,
# and high.
OPENAI_TEXT_VERBOSITY=

# Independent compatible route for Ollama, gateways, and other
# servers. Select with AI_PROVIDER=openai-compatible.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_KEY_FILE=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
# responses preserves existing behavior; chat-completions calls /chat/completions.
# Choose explicitly for servers that do not implement /responses.
OPENAI_COMPATIBLE_API_FORMAT=responses
OPENAI_COMPATIBLE_MAX_OUTPUT_TOKENS=4096
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=6
# Leave provider-specific extensions blank unless the server documents them.
OPENAI_COMPATIBLE_REASONING_EFFORT=
OPENAI_COMPATIBLE_TEXT_VERBOSITY=

ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=6

# SQLITE_PATH is intentionally left unset.
#
# Local `go run`: defaults to ./brainslug.db.
# Docker: the image sets SQLITE_PATH=/data/brainslug.db, which is the mounted
# volume. Compose passes every variable in this file straight through, and that
# overrides the image default, so setting SQLITE_PATH here sends the database to
# a directory the container user cannot write and the service fails to start.
#
# Only set this if you know which of the two you are configuring.
# SQLITE_PATH=./brainslug.db

# Dashboard-managed provider/model settings are non-secret and default beside
# the SQLite database (for example ./brainslug.settings.json or
# /data/brainslug.settings.json). Override only when needed. The file records
# only values saved in the dashboard that differ from this environment; those
# values win over the variables here, and the dashboard lists every variable
# they replace. Saving the environment's value in the dashboard removes the
# override.
# RUNTIME_SETTINGS_PATH=./brainslug.settings.json

# API keys entered in the loopback dashboard are stored in a private file
# beside SQLite by default (for example ./brainslug.provider-auth.json).
# PROVIDER_AUTH_FILE=./brainslug.provider-auth.json

# The first-run management owner password hash defaults beside SQLite. Delete
# this file only when intentionally resetting local portal ownership.
# ADMIN_AUTH_FILE=./brainslug.admin-auth.json
# Leave false for native installs. Docker Compose explicitly enables this only
# behind its host-loopback port mapping.
ADMIN_SETUP_TRUST_PROXY=false

# Verified mode fails closed until the exact ID from the Alexa Developer
# Console is configured.
ALEXA_VERIFY_REQUESTS=true
ALEXA_ALLOWED_SKILL_ID=

LOG_LEVEL=info
SAVE_HISTORY=true
# Independent Codex controller connection (disabled until explicitly paired).
CODEX_ENABLED=false
CODEX_ROUTING_MODE=manual
CODEX_CONTROLLER_URL=
CODEX_CLIENT_CERT=
CODEX_CLIENT_KEY=
CODEX_CA_FILE=
CODEX_SERVER_NAME=
