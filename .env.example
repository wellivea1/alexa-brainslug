SERVER_ADDR=:8080
PUBLIC_BASE_URL=https://brain-slug.example.com

AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_TIMEOUT_SECONDS=12

ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_OUTPUT_TOKENS=600
ANTHROPIC_TIMEOUT_SECONDS=12

OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_PASSWORD_FILE=
OPENCODE_MODEL=
OPENCODE_MAX_OUTPUT_TOKENS=600
OPENCODE_TIMEOUT_SECONDS=12

SQLITE_PATH=./brainslug.db

ALEXA_VERIFY_REQUESTS=true
ALEXA_ALLOWED_SKILL_ID=

LOG_LEVEL=info
SAVE_HISTORY=true
