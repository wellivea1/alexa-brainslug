# Local processes bind both listeners to host loopback by default. Docker
# Compose overrides these two addresses inside the container, then publishes
# both ports back to host loopback.
SERVER_ADDR=127.0.0.1:8080
ADMIN_SERVER_ADDR=127.0.0.1:8081

PUBLIC_BASE_URL=https://brain-slug.example.com

AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
# api_key uses the official OpenAI API. chatgpt uses the local dashboard's
# ChatGPT account connection and the account-scoped Codex transport.
OPENAI_AUTH_MODE=api_key
# Defaults beside SQLITE_PATH (for example ./brainslug.openai-auth.json).
# OPENAI_CHATGPT_AUTH_FILE=./brainslug.openai-auth.json
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=

# Reasoning models spend max_output_tokens on both internal reasoning and
# visible output. This is headroom, not a target answer length.
OPENAI_MAX_OUTPUT_TOKENS=25000

# The current ASK path is synchronous. Keep the provider call short enough to
# leave room inside Alexa's external request deadline until deferred jobs land.
OPENAI_TIMEOUT_SECONDS=6

# Leave blank for the provider default and broad compatible-endpoint support.
# GPT-5.6 also supports none, low, medium, high, xhigh, and max.
OPENAI_REASONING_EFFORT=

# Leave blank for the provider default. Official OpenAI accepts low, medium,
# and high; compatible endpoints may not implement this field.
OPENAI_TEXT_VERBOSITY=

ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=6

# SQLITE_PATH is intentionally left unset.
#
# Local `go run`: defaults to ./brainslug.db.
# Docker: the image sets SQLITE_PATH=/data/brainslug.db, which is the mounted
# volume. Compose passes every variable in this file straight through, and that
# overrides the image default, so setting SQLITE_PATH here sends the database to
# a directory the container user cannot write and the service fails to start.
#
# Only set this if you know which of the two you are configuring.
# SQLITE_PATH=./brainslug.db

# Dashboard-managed provider/model settings are non-secret and default beside
# the SQLite database (for example ./brainslug.settings.json or
# /data/brainslug.settings.json). Override only when needed.
# RUNTIME_SETTINGS_PATH=./brainslug.settings.json

# API keys entered in the loopback dashboard are stored in a private file
# beside SQLite by default (for example ./brainslug.provider-auth.json).
# PROVIDER_AUTH_FILE=./brainslug.provider-auth.json

# Verified mode fails closed until the exact ID from the Alexa Developer
# Console is configured.
ALEXA_VERIFY_REQUESTS=true
ALEXA_ALLOWED_SKILL_ID=

LOG_LEVEL=info
SAVE_HISTORY=true
