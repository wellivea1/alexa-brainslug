brain-slug.example.com {
	# Only /alexa is public.
	#
	# The separate administrative listener on port 8081 serves a dashboard at /
	# and a history JSON feed at /history. Both are unauthenticated and contain
	# every prompt and answer that has passed through the gateway. Never proxy
	# port 8081 publicly.
	handle /alexa {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		respond "Not found" 404
	}
}
